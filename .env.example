# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key used for AI-assisted pre-interview scoring.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Password staff use to log into /admin. Change this to something strong.
ADMIN_PASSWORD=change-me-now

# Random long string used to sign the admin session cookie.
SESSION_SECRET=change-this-to-a-random-string

# Port the server runs on (most hosts set this for you automatically).
PORT=3000
